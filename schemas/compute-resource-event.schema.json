{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pzy19-prog/compute-commons/schemas/compute-resource-event.schema.json",
  "title": "Compute Resource Event",
  "description": "Draft provider-agnostic AI inference resource accounting event.",
  "type": "object",
  "required": ["schema_version", "event_id", "event_time", "provider", "model", "surface", "evidence"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "event_id": {"type": "string", "minLength": 1},
    "event_time": {"type": "string", "format": "date-time"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "surface": {"type": "string", "minLength": 1},
    "execution": {
      "type": "object",
      "properties": {
        "task_id": {"type": "string"},
        "step_id": {"type": "string"},
        "request_id": {"type": "string"},
        "conversation_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["class", "source"],
      "properties": {
        "class": {"enum": ["observed", "declared", "calculated", "estimated"]},
        "source": {"type": "string", "minLength": 1},
        "source_version": {"type": "string"},
        "observed_at": {"type": "string", "format": "date-time"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": "integer", "minimum": 0},
        "cache_read_tokens": {"type": "integer", "minimum": 0},
        "cache_write_tokens": {"type": "integer", "minimum": 0},
        "request_count": {"type": "integer", "minimum": 0},
        "native_units": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {"type": "number"},
              {"type": "string"},
              {"type": "boolean"}
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "commercial": {
      "type": "object",
      "required": ["amount", "currency", "class"],
      "properties": {
        "amount": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "minLength": 3},
        "class": {"enum": ["observed", "calculated", "estimated"]},
        "pricing_version": {"type": "string"},
        "pricing_effective_at": {"type": "string", "format": "date-time"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "quota": {
      "type": "object",
      "required": ["scope", "unit", "observed_at"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "limit": {"type": "number", "minimum": 0},
        "remaining": {"type": "number", "minimum": 0},
        "consumed": {"type": "number", "minimum": 0},
        "observed_at": {"type": "string", "format": "date-time"},
        "reset_at": {"type": "string", "format": "date-time"},
        "window": {"type": "string"},
        "class": {"enum": ["observed", "declared", "calculated", "estimated"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "compute_proxy": {
      "type": "object",
      "properties": {
        "accelerator_seconds": {"type": "number", "minimum": 0},
        "accelerator_type": {"type": "string"},
        "flops_estimate": {"type": "number", "minimum": 0},
        "energy_joules_estimate": {"type": "number", "minimum": 0},
        "class": {"enum": ["observed", "declared", "calculated", "estimated"]},
        "method": {"type": "string"},
        "method_version": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "normalized": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "value", "unit", "method", "method_version", "class"],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "value": {"type": "number"},
          "unit": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "method_version": {"type": "string", "minLength": 1},
          "class": {"enum": ["calculated", "estimated"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced provider- or experiment-specific fields.",
      "additionalProperties": true
    }
  },
  "anyOf": [
    {"required": ["usage"]},
    {"required": ["commercial"]},
    {"required": ["quota"]},
    {"required": ["compute_proxy"]},
    {"required": ["normalized"]}
  ],
  "additionalProperties": false
}
